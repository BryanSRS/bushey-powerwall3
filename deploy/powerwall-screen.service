# systemd unit for the ThinkCentre.
# Edit User= and the paths if you clone somewhere other than /opt/bushey-powerwall3, then:
#   sudo cp deploy/powerwall-screen.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now powerwall-screen
[Unit]
Description=Bushey Powerwall data screen
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bryan
WorkingDirectory=/opt/bushey-powerwall3
ExecStart=/opt/bushey-powerwall3/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
