# Copy this file to .env and fill it in. Never commit .env.

# "mock" generates fake data so you can work on the screen without the Powerwall.
# "tedapi" reads the Powerwall 3 locally over its Wi-Fi access point.
PW_MODE=mock

# Powerwall 3 local address (reachable only while joined to the Powerwall's Wi-Fi)
PW_HOST=192.168.91.1

# Password from the Powerwall label (the same one used to join its Wi-Fi network)
PW_GW_PASSWORD=

PW_TIMEZONE=America/New_York

# How often to read the Powerwall, in seconds
POLL_SECONDS=5

# Where readings are stored
DB_PATH=data/powerwall.db

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8080
